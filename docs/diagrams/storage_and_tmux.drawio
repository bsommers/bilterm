        <mxCell id="st1" edge="1" parent="1" source="cfg" target="core" style="edgeStyle=orthogonalEdgeStyle;html=1;" />
        <mxCell id="st2" edge="1" parent="1" source="core" target="hist" style="edgeStyle=orthogonalEdgeStyle;html=1;dir=both;" />
        <mxCell id="st3" edge="1" parent="1" source="core" target="tmux_a" style="edgeStyle=orthogonalEdgeStyle;html=1;dir=both;" />
        <mxCell id="st4" edge="1" parent="1" source="core" target="tmux_b" style="edgeStyle=orthogonalEdgeStyle;html=1;dir=both;" />
